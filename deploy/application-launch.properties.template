# This complete external configuration replaces the JAR's embedded profiles.
# Fill every @PLACEHOLDER@ in a private copy; never commit the filled file.
version=2.8.0
spring.profiles.active=launch
server.address=@API_BIND_ADDRESS@
server.port=@API_PORT@
server.servlet.context-path=/api
server.tomcat.max-swallow-size=-1
server.compression.enabled=true
server.compression.min-response-size=1024
spring.servlet.multipart.max-file-size=1000MB
spring.servlet.multipart.max-request-size=1000MB
spring.http.multipart.location=@MULTIPART_DIRECTORY@
spring.autoconfigure.exclude=com.alibaba.druid.spring.boot.autoconfigure.DruidDataSourceAutoConfigure
spring.datasource.dynamic.primary=master
spring.datasource.dynamic.datasource.master.url=@MYSQL_JDBC_URL@
spring.datasource.dynamic.datasource.master.username=@MYSQL_APP_USERNAME@
spring.datasource.dynamic.datasource.master.password=@MYSQL_APP_PASSWORD@
spring.datasource.dynamic.datasource.master.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.dynamic.druid.initial-size=1
spring.datasource.dynamic.druid.min-idle=1
spring.datasource.dynamic.druid.max-active=20
spring.datasource.dynamic.druid.max-wait=60000
spring.datasource.dynamic.druid.validation-query=SELECT 1
spring.datasource.dynamic.druid.test-while-idle=true
spring.datasource.druid.stat-view-servlet.enabled=false
spring.datasource.druid.web-stat-filter.enabled=false
spring.redis.host=@REDIS_HOST@
spring.redis.port=@REDIS_PORT@
spring.redis.database=@REDIS_DATABASE@
spring.redis.password=@REDIS_PASSWORD@
spring.quartz.job-store-type=memory
spring.quartz.auto-startup=false
spring.quartz.overwrite-existing-jobs=false
spring.quartz.jdbc.initialize-schema=never
spring.jackson.date-format=yyyy-MM-dd HH:mm:ss
spring.jackson.time-zone=GMT+8
spring.aop.proxy-target-class=true
spring.activiti.check-process-definitions=false
spring.activiti.async-executor-activate=false
spring.activiti.job-executor-activate=false
spring.jpa.open-in-view=false
spring.freemarker.suffix=.ftl
spring.freemarker.content-type=text/html
spring.freemarker.charset=UTF-8
spring.freemarker.cache=false
spring.freemarker.prefer-file-system-access=false
spring.freemarker.template-loader-path=classpath:/templates
spring.mvc.static-path-pattern=/**
spring.resource.static-locations=classpath:/static/,classpath:/public/
mybatis-plus.mapper-locations=classpath*:org/jeecg/modules/**/xml/*Mapper.xml
mybatis-plus.global-config.banner=false
mybatis-plus.global-config.db-config.id-type=UUID
mybatis-plus.global-config.db-config.table-underline=true
mybatis-plus.configuration.call-setters-on-nulls=true
jeecg.multiLogin=false
jeecg.domain=@PUBLIC_ORIGIN@
jeecg.uploadType=local
jeecg.path.upload=@UPLOAD_DIRECTORY@
jeecg.path.webapp=@WEBAPP_DIRECTORY@
jeecg.path.staticDomain=/api/sys/common/static
jeecg.media.cookie-name=teaching_media
jeecg.filePreview=local
jeecg.shiro.excludeUrls=
# Optional external integrations stay disabled in the initial launch.
ueip=false
justauth.enabled=false
spring.mail.host=127.0.0.1
spring.mail.port=9
spring.mail.username=disabled@example.invalid
spring.mail.password=disabled
spring.mail.properties.mail.smtp.auth=false
jeecg.file-view-domain=http://127.0.0.1:9
jeecg.ow365.id=disabled
jeecg.ow365.key=disabled
jeecg.ow365.iv=disabled
jeecg.elasticsearch.check-enabled=false
jeecg.elasticsearch.cluster-nodes=127.0.0.1:9
jeecg.qiniu.accessKey=disabled
jeecg.qiniu.secretKey=disabled
jeecg.qiniu.staticDomain=http://127.0.0.1:9
jeecg.qiniu.bucketName=disabled
jeecg.qiniu.area=z0
jeecg.oss.endpoint=http://127.0.0.1:9
jeecg.oss.accessKey=disabled
jeecg.oss.secretKey=disabled
jeecg.oss.bucketName=disabled
jeecg.oss.staticDomain=http://127.0.0.1:9
jeecg.sms.accessKeyId=disabled
jeecg.sms.accessKeySecret=disabled
jeecg.minio.minio_url=http://127.0.0.1:9
jeecg.minio.minio_name=disabled
jeecg.minio.minio_pass=disabled
jeecg.minio.bucketName=disabled
cas.prefixUrl=http://127.0.0.1:9
swagger.enable=false
swagger.production=true
swagger.basic.enable=false
springfox.documentation.enabled=false
springfox.documentation.auto-startup=false
springfox.documentation.swagger-ui.enabled=false
management.endpoints.web.exposure.include=health
logging.level.org.jeecg.modules.system.mapper=WARN
logging.level.org.jeecg.modules.teaching.mapper=WARN
logging.level.org.jeecg.modules.wechat.mapper=WARN
logging.level.org.jeecg.modules.shiro=WARN
