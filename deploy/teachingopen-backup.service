[Unit]
Description=TeachingOpen private database and uploads backup with restore verification
After=teachingopen-mysql.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/sbin/teachingopen-backup.py backup --config /etc/teachingopen-backup.json
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
